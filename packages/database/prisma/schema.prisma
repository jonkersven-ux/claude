// ─────────────────────────────────────────────────────────
// HostIQ — Database Schema
// Multi-tenant corporate sports hospitality platform
// ─────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// TENANT & AUTH
// ═══════════════════════════════════════════════════════════

model Company {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  domain        String?
  logoUrl       String?
  plan          Plan     @default(STARTER)
  maxSeats      Int      @default(10)
  maxUsers      Int      @default(5)
  settings      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  seasons       Season[]
  guests        Guest[]
  venues        Venue[]
  costs         Cost[]
  aiInsights    AiInsight[]
  promptTemplates PromptTemplate[]
  invitationTemplates InvitationTemplate[]
  marketplaceBookings MarketplaceBooking[]

  @@map("companies")
}

enum Plan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model User {
  id            String    @id @default(cuid())
  companyId     String
  email         String
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole  @default(MEMBER)
  avatarUrl     String?
  phone         String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  managedGuests       Guest[]        @relation("AccountManager")
  createdInvitations  Invitation[]   @relation("InvitationCreator")
  eventNotes          EventNote[]
  followUpTasks       FollowUpTask[]
  aiInsights          AiInsight[]

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  HOST
}

// ═══════════════════════════════════════════════════════════
// MODULE 1: STRATEGY & SEASON PLANNING
// ═══════════════════════════════════════════════════════════

model Venue {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  city          String?
  country       String?
  sportType     String?
  logoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seasons       Season[]

  @@index([companyId])
  @@map("venues")
}

model Season {
  id            String       @id @default(cuid())
  companyId     String
  venueId       String
  name          String                             // e.g. "2026/2027"
  startDate     DateTime
  endDate       DateTime
  status        SeasonStatus @default(PLANNING)
  totalBudget   Decimal?     @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  venue         Venue        @relation(fields: [venueId], references: [id])
  matches       Match[]
  seatBlocks    SeatBlock[]

  @@index([companyId])
  @@map("seasons")
}

enum SeasonStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

model SeatBlock {
  id            String   @id @default(cuid())
  seasonId      String
  label         String                             // e.g. "Skybox A", "Business Seats Row 1"
  seatType      SeatType
  capacity      Int
  costPerMatch  Decimal? @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime @default(now())

  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seatAllocations SeatAllocation[]

  @@map("seat_blocks")
}

enum SeatType {
  SKYBOX
  BUSINESS_SEAT
  VIP_LOUNGE
  SUITE
  OTHER
}

model Match {
  id              String        @id @default(cuid())
  seasonId        String
  homeTeam        String
  awayTeam        String
  matchDate       DateTime
  kickoffTime     DateTime?
  priority        MatchPriority @default(NORMAL)
  objective       MatchObjective?
  status          MatchStatus   @default(SCHEDULED)
  maxGuests       Int?
  notes           String?
  externalId      String?                          // for calendar/API sync
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  season          Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  invitations     Invitation[]
  seatAllocations SeatAllocation[]
  eventNotes      EventNote[]
  followUpTasks   FollowUpTask[]
  costs           Cost[]
  revenues        Revenue[]
  aiInsights      AiInsight[]

  @@index([seasonId])
  @@index([matchDate])
  @@map("matches")
}

enum MatchPriority {
  A_MATCH
  HIGH
  NORMAL
  LOW
}

enum MatchObjective {
  NEW_BUSINESS
  RETENTION
  NETWORKING
  EMPLOYEE_ENGAGEMENT
  PARTNERSHIP
  BRAND
}

enum MatchStatus {
  SCHEDULED
  INVITATIONS_OPEN
  CONFIRMED
  MATCHDAY
  COMPLETED
  CANCELLED
}

// ═══════════════════════════════════════════════════════════
// MODULE 2: GUEST INTELLIGENCE CRM
// ═══════════════════════════════════════════════════════════

model Guest {
  id                  String            @id @default(cuid())
  companyId           String
  accountManagerId    String?
  firstName           String
  lastName            String
  email               String?
  phone               String?
  jobTitle            String?
  guestCompany        String?                      // company the guest works for
  linkedInUrl         String?
  avatarUrl           String?
  commercialValue     CommercialValue   @default(MEDIUM)
  relationshipStage   RelationshipStage @default(PROSPECT)
  dietaryRequirements String?
  parkingRequired     Boolean           @default(false)
  notes               String?
  tags                String[]          @default([])
  customFields        Json              @default("{}")
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountManager      User?             @relation("AccountManager", fields: [accountManagerId], references: [id])

  invitations         Invitation[]
  opportunities       Opportunity[]
  eventNotes          EventNote[]
  aiInsights          AiInsight[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([accountManagerId])
  @@index([relationshipStage])
  @@map("guests")
}

enum CommercialValue {
  VERY_HIGH
  HIGH
  MEDIUM
  LOW
}

enum RelationshipStage {
  PROSPECT
  QUALIFIED_LEAD
  ACTIVE_CLIENT
  STRATEGIC_PARTNER
  CHURNED
  INTERNAL
}

model Opportunity {
  id              String            @id @default(cuid())
  guestId         String
  title           String
  value           Decimal?          @db.Decimal(12, 2)
  currency        String            @default("EUR")
  stage           OpportunityStage  @default(IDENTIFIED)
  probability     Int?                               // 0–100
  expectedCloseDate DateTime?
  notes           String?
  wonAt           DateTime?
  lostAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  guest           Guest             @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@map("opportunities")
}

enum OpportunityStage {
  IDENTIFIED
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

// ═══════════════════════════════════════════════════════════
// MODULE 3: INVITATION & EVENT FLOW
// ═══════════════════════════════════════════════════════════

model Invitation {
  id              String           @id @default(cuid())
  matchId         String
  guestId         String
  createdById     String
  status          InvitationStatus @default(DRAFT)
  sentAt          DateTime?
  respondedAt     DateTime?
  checkedInAt     DateTime?
  qrCode          String?          @unique
  personalMessage String?
  dietaryNotes    String?
  parkingRequested Boolean         @default(false)
  extraRequests   String?
  reminderSentAt  DateTime?
  calendarSentAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  match           Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  guest           Guest            @relation(fields: [guestId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("InvitationCreator", fields: [createdById], references: [id])
  seatAllocation  SeatAllocation?

  @@unique([matchId, guestId])
  @@index([matchId])
  @@index([guestId])
  @@index([status])
  @@map("invitations")
}

enum InvitationStatus {
  DRAFT
  SENT
  OPENED
  ACCEPTED
  DECLINED
  WAITLISTED
  CHECKED_IN
  NO_SHOW
  CANCELLED
}

model SeatAllocation {
  id            String     @id @default(cuid())
  seatBlockId   String
  invitationId  String     @unique
  matchId       String
  seatLabel     String?                            // e.g. "Seat 4"
  createdAt     DateTime   @default(now())

  seatBlock     SeatBlock  @relation(fields: [seatBlockId], references: [id])
  invitation    Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  match         Match      @relation(fields: [matchId], references: [id])

  @@map("seat_allocations")
}

model InvitationTemplate {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  subject       String
  bodyHtml      String
  bodyText      String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("invitation_templates")
}

// ═══════════════════════════════════════════════════════════
// MODULE 4: HOST COMPANION (MATCHDAY)
// ═══════════════════════════════════════════════════════════

model EventNote {
  id            String   @id @default(cuid())
  matchId       String
  guestId       String?
  authorId      String
  content       String
  isVoiceNote   Boolean  @default(false)
  audioUrl      String?
  sentiment     String?                            // AI-derived
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  guest         Guest?   @relation(fields: [guestId], references: [id])
  author        User     @relation(fields: [authorId], references: [id])

  @@index([matchId])
  @@index([guestId])
  @@map("event_notes")
}

model FollowUpTask {
  id            String         @id @default(cuid())
  matchId       String
  assigneeId    String
  guestId       String?
  title         String
  description   String?
  dueDate       DateTime?
  priority      TaskPriority   @default(MEDIUM)
  status        TaskStatus     @default(PENDING)
  completedAt   DateTime?
  aiGenerated   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  match         Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  assignee      User           @relation(fields: [assigneeId], references: [id])

  @@index([matchId])
  @@index([assigneeId])
  @@index([status])
  @@map("follow_up_tasks")
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ═══════════════════════════════════════════════════════════
// MODULE 5: ROI & PERFORMANCE
// ═══════════════════════════════════════════════════════════

model Cost {
  id            String       @id @default(cuid())
  companyId     String
  matchId       String?
  category      CostCategory
  description   String
  amount        Decimal      @db.Decimal(12, 2)
  currency      String       @default("EUR")
  date          DateTime
  createdAt     DateTime     @default(now())

  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  match         Match?       @relation(fields: [matchId], references: [id])

  @@index([companyId])
  @@index([matchId])
  @@map("costs")
}

enum CostCategory {
  SEASON_PASS
  CATERING
  TRANSPORT
  GIFTS
  HOST_FEE
  MARKETING
  MISCELLANEOUS
}

model Revenue {
  id              String   @id @default(cuid())
  matchId         String
  opportunityId   String?
  description     String
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("EUR")
  isAttributed    Boolean  @default(false)         // confirmed hospitality-influenced
  attributionNote String?
  date            DateTime
  createdAt       DateTime @default(now())

  match           Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@map("revenues")
}

// ═══════════════════════════════════════════════════════════
// MODULE 6: MARKETPLACE (Phase 2 ready)
// ═══════════════════════════════════════════════════════════

model MarketplaceService {
  id            String                @id @default(cuid())
  category      MarketplaceCategory
  name          String
  description   String?
  basePrice     Decimal?              @db.Decimal(10, 2)
  currency      String                @default("EUR")
  isActive      Boolean               @default(true)
  metadata      Json                  @default("{}")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  bookings      MarketplaceBooking[]

  @@map("marketplace_services")
}

enum MarketplaceCategory {
  HOST_BOOKING
  TRANSPORT
  GIFT
  EXPERIENCE
  CATERING
}

model MarketplaceBooking {
  id            String             @id @default(cuid())
  companyId     String
  serviceId     String
  matchId       String?
  status        BookingStatus      @default(REQUESTED)
  quantity      Int                @default(1)
  totalPrice    Decimal?           @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service       MarketplaceService @relation(fields: [serviceId], references: [id])

  @@index([companyId])
  @@map("marketplace_bookings")
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ═══════════════════════════════════════════════════════════
// AI SYSTEM
// ═══════════════════════════════════════════════════════════

model AiInsight {
  id            String      @id @default(cuid())
  companyId     String
  userId        String?
  matchId       String?
  guestId       String?
  type          InsightType
  title         String
  content       String
  confidence    Float?                              // 0.0 – 1.0
  metadata      Json        @default("{}")
  isRead        Boolean     @default(false)
  isDismissed   Boolean     @default(false)
  createdAt     DateTime    @default(now())

  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id])
  match         Match?      @relation(fields: [matchId], references: [id])
  guest         Guest?      @relation(fields: [guestId], references: [id])

  @@index([companyId])
  @@index([type])
  @@map("ai_insights")
}

enum InsightType {
  GUEST_PRIORITIZATION
  MATCH_RECOMMENDATION
  FOLLOW_UP_SUGGESTION
  ROI_INSIGHT
  RELATIONSHIP_HEALTH
  UTILIZATION_ALERT
  EMAIL_DRAFT
  CONVERSATION_SUMMARY
}

model PromptTemplate {
  id            String   @id @default(cuid())
  companyId     String?                             // null = system-wide default
  slug          String                              // e.g. "follow-up-email"
  name          String
  description   String?
  systemPrompt  String
  userPrompt    String
  model         String   @default("claude-sonnet-4-20250514")
  temperature   Float    @default(0.7)
  maxTokens     Int      @default(1024)
  isActive      Boolean  @default(true)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, slug, version])
  @@map("prompt_templates")
}
